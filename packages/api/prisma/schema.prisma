generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id
  name      String
  email     String    @unique
  hash      String
  gender    Gender
  birthDate DateTime?

  // Onboarding section
  timeCommitment Int
  preferredTool  PreferredTool
  issue          UserIssue

  moodNotes MoodNote[]
  tests     Test[]
}

model Waitlist {
  id    String @id
  email String @unique
}

enum Gender {
  male
  female
  unknown
}

enum UserIssue {
  anxiety
  depression
  burnout
  stress
  lowMood
  focus
  badSleep
  other
}

enum PreferredTool {
  quickTool
  deepExcercise
  tracking
  education
}

model MoodNote {
  id          String            @id
  title       String?
  emotion     Emotion
  tags        TagsOnMoodNotes[]
  intencity   Int
  description String?
  createdAt   DateTime          @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  activity   Activity? @relation(fields: [activityId], references: [id])
  activityId String?
}

model Activity {
  id          String     @id
  name        String
  description String
  moodNotes   MoodNote[]
}

enum Emotion {
  happy
  sad
  angry
  anxious
  calm
  tired
  lonely
  stressed
  grateful
}

// Standard GAD-7 test
model Test {
  id        String       @id
  type      TestType
  createdAt DateTime     @default(now())
  score     Int
  answers   TestAnswer[]

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model TestAnswer {
  id             String @id
  questionNumber Int
  score          Int

  testId String
  test   Test   @relation(fields: [testId], references: [id])
}

enum TestType {
  PHQ9 // Depression
  GAD7 // Anxiety
}

model MoodTag {
  name     String       @unique
  category MoodCategory

  TagsOnMoodNotes TagsOnMoodNotes[]
}

enum MoodCategory {
  school
  work
  money
  health
  relationships
}

model TagsOnMoodNotes {
  moodNote    MoodNote @relation(fields: [moodNoteId], references: [id])
  moodNoteId  String
  moodTag     MoodTag  @relation(fields: [moodTagName], references: [name])
  moodTagName String

  @@id([moodNoteId, moodTagName])
}
